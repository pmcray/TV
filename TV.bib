  year = {},
  note = {In Semantic Information Processing, edited by Marvin}
}

@article{MT_Minsky_41,
  author = {Minsky},
  title = {Cambridge, Mass.: MIT Press (1968): 271-353. Perhaps the first truly large system ever written in Lisp, this impressive project is often pointed to as having "solved" the problem of analogies. How far from the truth that is!},
  year = {1968},
  note = {}
}

@book{MT_Ewing_42,
  author = {Ewing, John and Czes Koiniowski},
  title = {Puzzle It Out: Cubes, Groups, and Puzzles.},
  year = {1982},
