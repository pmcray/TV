  title = {et al.},
  year = {1980},
  note = {"The Hearsay-II Speech-Understanding System: Integrating Knowledge to Resolve Uncertainty". ACM Computing Surveys 2, no. 2 (June 1980): 213-53. A review article describing, with a good deal of hindsight, the architecture and performance of what I consider to be the most inspiring work yet done in artificial intelligence.}
}

@article{MT_Evans_40,
  author = {Evans, Thomas G},
