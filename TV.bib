}

@book{MT_Franke_50,
  author = {Franke, H},
  title = {W.},
  year = {1971},
  note = {Computer Graphics-Computer Art. New York: Phaidon, 1971. By far the best collection of examples and discussion of computers and art I have yet seen, even though it is quite old by now.}
}

@book{MT_Frey_51,
  author = {Frey, Alexander H},
  title = {, Jr.},
